import { create } from "zustand";
import { notificationsApi } from "../api/notifications";

type State = {
  vacationsPending: number;
  swapsIncoming: number;
  shiftChangesIncoming: number;
  timeOffsPending: number; // <--- НОВОЕ
  refresh: () => Promise<void>;
};



export const useNotifications = create<State>((set) => ({
  vacationsPending: 0,
  swapsIncoming: 0,
  shiftChangesIncoming: 0,
  timeOffsPending: 0, // <--- НОВОЕ

  refresh: async () => {
    const [v, s, sc, t] = await Promise.all([
      notificationsApi.vacationsPendingCount(),
      notificationsApi.swapsIncomingCount(),
      notificationsApi.shiftChangesIncomingCount(),
      notificationsApi.timeOffsPendingCount(), // <--- НОВОЕ
    ]);
    set({ vacationsPending: v, swapsIncoming: s, shiftChangesIncoming: sc, timeOffsPending: t });
  },
}));