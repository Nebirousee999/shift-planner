import { useEffect, useState, useMemo } from "react";
import { useNavigate } from "react-router-dom";
import {
  Clock, CalendarDays, ChevronRight, ChevronLeft, AlertCircle,
  Timer, ArrowRightLeft, UserCircle, CalendarX2, Activity, Wallet, Banknote,
  FileEdit, AlertTriangle, X, Check, Palmtree, Eye, Bell,
} from "lucide-react";
import { dashboardApi, type DashboardSummary } from "../api/dashboard";
import { meApi, type MyProfile } from "../api/me";
import { shiftsApi } from "../api/weeks";
import { useAuth } from "../store/auth";
import { useWeeks } from "../store/weeks";
import { useNotifications } from "../store/notifications";
import { useLocations } from "../store/locations";
import { useShiftTemplates } from "../store/shiftTemplates";
import { useTimeOff } from "../store/timeOff";
import { useSwaps } from "../store/swaps";
import { useVacations } from "../store/vacations";
         import { shiftChangeRequestsApi, type ShiftChangeRequest } from "../api/shiftChangeRequests";
import NavBar from "../components/NavBar";
import { shortDate, dayLabel, weekDates } from "../lib/dates";

const MONTHS_RU = ["Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"];
const WEEKDAYS_RU = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];

const calcHours = (start: string, end: string) => {
  const [sh, sm] = start.split(":").map(Number);
  const [eh, em] = end.split(":").map(Number);
  let m = eh * 60 + em - (sh * 60 + sm);
  if (m <= 0) m += 24 * 60;
  return m / 60;
};

const formatMoney = (n: number) => new Intl.NumberFormat("ru-RU").format(n) + " ₽";

const addDays = (dateStr: string, n: number): string => {
  const d = new Date(dateStr + "T00:00:00Z");
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0, 10);
};

function timeToPercent(time: string): number {
  if (!time) return 0;
  const [h, m] = time.split(":").map(Number);
  return ((h * 60 + m) / (24 * 60)) * 100;
}
function timeToMins(time: string): number {
  const [h, m] = time.split(":").map(Number);
  return h * 60 + m;
}
function formatHours(h: number): string {
  if (!h || h === 0) return "0 ч";
  const hours = Math.floor(h);
  const mins = Math.round((h - hours) * 60);
  if (hours === 0) return `${mins} мин`;
  if (mins === 0) return `${hours} ч`;
  return `${hours} ч ${mins} м`;
}

const STATUS_COLORS: Record<string, string> = {
  DRAFT: "bg-slate-100 text-slate-600 ring-slate-200",
  PUBLISHED: "bg-emerald-50 text-emerald-700 ring-emerald-200",
  LOCKED: "bg-red-50 text-red-700 ring-red-200",
};
const STATUS_LABELS: Record<string, string> = {
  DRAFT: "Черновик",
  PUBLISHED: "Опубликован",
  LOCKED: "Заблокирован",
};

export default function DashboardPage() {
  const navigate = useNavigate();
  const { user } = useAuth();
  const isEmployee = user?.role === "EMPLOYEE";

  const { weeks, fetchWeeks } = useWeeks();
  const { refresh: refreshNotifs } = useNotifications();
  const { activeLocationId, fetch: fetchLocations } = useLocations();
  const { items: templates, fetch: fetchTemplates } = useShiftTemplates();

  const { items: timeOffs, fetch: fetchTimeOffs, approve: approveTimeOff, reject: rejectTimeOff } = useTimeOff();
  const { incoming: swapsIncomingList, fetchMine: fetchSwaps, accept: acceptSwap, decline: declineSwap } = useSwaps();
  const { all: vacations, fetchAll: fetchVacations } = useVacations();

  const [data, setData] = useState<DashboardSummary | null>(null);
  const [profile, setProfile] = useState<MyProfile | null>(null);
  const [loading, setLoading] = useState(true);
  const [now, setNow] = useState(new Date());

  const todayDate = now.toISOString().slice(0, 10);
  const [selectedDate, setSelectedDate] = useState(todayDate);

  const [disciplineShift, setDisciplineShift] = useState<any | null>(null);
  const [hoveredShift, setHoveredShift] = useState<any | null>(null);
  const [showRequestsModal, setShowRequestsModal] = useState(false);
           const [pendingShiftChanges, setPendingShiftChanges] = useState<ShiftChangeRequest[]>([]);

  useEffect(() => {
    const timer = setInterval(() => setNow(new Date()), 60_000);
    return () => clearInterval(timer);
  }, []);

  useEffect(() => {
    fetchLocations();
    fetchTemplates();
  }, [fetchLocations, fetchTemplates]);

  const loadAllData = () => {
             if (!activeLocationId) return;
             Promise.all([
               dashboardApi.summary(activeLocationId),
               meApi.profile().catch(() => null),
               isEmployee ? Promise.resolve() : fetchTimeOffs(),
               fetchSwaps(),
               isEmployee ? Promise.resolve() : fetchVacations(),
               isEmployee
                 ? Promise.resolve<ShiftChangeRequest[]>([])
                 : shiftChangeRequestsApi.incoming().catch(() => [] as ShiftChangeRequest[]),
             ])
               .then(([dash, prof, , , , shiftChanges]) => {
                 setData(dash);
                 setProfile(prof);
                 if (!isEmployee) {
                   setPendingShiftChanges(
                     (shiftChanges as ShiftChangeRequest[]).filter((r) => r.status === "PENDING")
                   );
                 }
               })
               .catch(() => alert("Ошибка загрузки дашборда"))
               .finally(() => setLoading(false));
           };

  useEffect(() => {
    loadAllData();
    if (!isEmployee) {
      if (activeLocationId) fetchWeeks(activeLocationId);
      refreshNotifs();
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeLocationId, isEmployee]);

  const currentTimePercent = ((now.getHours() * 60 + now.getMinutes()) / (24 * 60)) * 100;

  const dates = data?.currentWeek ? weekDates(data.currentWeek.weekStartDate) : [];
  const canPrev = dates.length > 0 && selectedDate > dates[0];
  const canNext = dates.length > 0 && selectedDate < dates[6];
  const dateInWeek = dates.includes(selectedDate);

  useEffect(() => {
    if (dates.length === 0) return;
    if (!dates.includes(selectedDate)) setSelectedDate(todayDate);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [dates.join(","), selectedDate, todayDate]);

  const hourlyRate = profile?.hourlyRate ? Number(profile.hourlyRate) : 0;

  const shiftsForSelectedDate = useMemo(() => {
    if (!data?.currentWeek?.shifts) return [];
    const all = data.currentWeek.shifts;
    return all
      .filter((s) => String(s.shiftDate).slice(0, 10) === selectedDate)
      .map((s) => {
        const u = data.users.find((x) => x.id === s.userId);
        const tpl = templates.find((t) => t.id === s.templateId);

        const pendingTimeOff = timeOffs.find((t) => t.shiftId === s.id && t.status === "PENDING");
        const pendingSwap = swapsIncomingList.find((sw) => sw.shiftId === s.id && sw.status === "PENDING");

        return {
          id: s.id,
          weekId: (s as any).weekId,
          startTime: s.startTime,
          endTime: s.endTime,
          userId: s.userId,
          userName: u?.name ?? null,
          userPosition: u?.position ?? null,
          templateId: s.templateId,
          templateName: (s as any).templateName ?? tpl?.name ?? null,
          templateColor: tpl?.color ?? null,
          latenessMinutes: (s as any).latenessMinutes ?? 0,
          earlyLeaveMinutes: (s as any).earlyLeaveMinutes ?? 0,
          isNoShow: (s as any).isNoShow ?? false,
          isUnknownAbsence: (s as any).isUnknownAbsence ?? false,
          templateStartTime: tpl?.startTime ?? null,
          templateEndTime: tpl?.endTime ?? null,
          pendingTimeOff,
          pendingSwap,
        };
      });
  }, [data, selectedDate, templates, timeOffs, swapsIncomingList]);

  const myShiftsToday = shiftsForSelectedDate.filter((s) => s.userId === user?.id);
  const myShiftsWeek = data?.currentWeek?.shifts?.filter((s) => s.userId === user?.id) || [];
  const myEntriesToday = data?.weekTimeEntries?.filter((te) => te.userId === user?.id && String(te.clockIn).slice(0, 10) === selectedDate) || [];

  const plannedToday = myShiftsToday.reduce((acc, s) => acc + calcHours(s.startTime, s.endTime), 0);
  const plannedWeek = myShiftsWeek.reduce((acc, s) => acc + calcHours(s.startTime, s.endTime), 0);

  const calcActual = (entries: any[]) => {
    let h = 0;
    entries.forEach((te) => {
      const start = new Date(te.clockIn).getTime();
      const end = te.clockOut ? new Date(te.clockOut).getTime() : Date.now();
      h += (end - start) / 3600000;
    });
    return h;
  };
  const actualToday = calcActual(myEntriesToday);
  const actualWeek = calcActual(data?.weekTimeEntries?.filter((te) => te.userId === user?.id) || []);

  const getShiftStatus = (shift: any): "past" | "active" | "future" => {
    if (selectedDate < todayDate) return "past";
    if (selectedDate > todayDate) return "future";

    const nowM = now.getHours() * 60 + now.getMinutes();
    const startM = timeToMins(shift.startTime);
    const endM = timeToMins(shift.endTime);
    const isOvernight = endM < startM;

    if (isOvernight) {
      if (nowM >= startM) return "active";
      if (nowM < endM) return "active";
      return "future";
    }

    if (nowM < startM) return "future";
    if (nowM < endM) return "active";
    return "past";
  };

  let statusText = "Нет смен";
  let isWorking = false;
  if (myShiftsToday.length > 0) {
    const activeEntry = myEntriesToday.find((te) => !te.clockOut);
    const shift = myShiftsToday[0];
    const st = getShiftStatus(shift);
    const isAbsent = (shift as any).isNoShow || (shift as any).isUnknownAbsence;
    if (isAbsent) {
      statusText = (shift as any).isNoShow ? "Прогул" : "Неявка";
    } else if (activeEntry) {
      statusText = "В работе";
      isWorking = true;
    } else if (st === "past") statusText = "Смена окончена";
    else if (st === "active") { statusText = "В работе"; isWorking = true; }
    else statusText = "Не началась";
  }

  const todayShiftsToShow = isEmployee ? myShiftsToday : shiftsForSelectedDate;

  const allUsers = data?.users || [];
  const calcCost = (shifts: any[]) => {
    return shifts.reduce((acc, s) => {
      const u = allUsers.find((x: any) => x.id === s.userId);
      const rate = u?.hourlyRate ? Number(u.hourlyRate) : 0;
      return acc + calcHours(s.startTime, s.endTime) * rate;
    }, 0);
  };

  const todayCost = calcCost(todayShiftsToShow);
  const weekCost = calcCost(data?.currentWeek?.shifts || []);

  const currentMonthStr = selectedDate.slice(0, 7);
  let monthShiftsCount = 0;
  let monthCost = 0;
  weeks.forEach((w) => {
    if (!String(w.weekStartDate).startsWith(currentMonthStr)) return;
    w.shifts?.forEach((s) => {
      if (s.userId) {
        const u = allUsers.find((x: any) => x.id === s.userId);
        const rate = u?.hourlyRate ? Number(u.hourlyRate) : 0;
        monthCost += calcHours(s.startTime, s.endTime) * rate;
        monthShiftsCount++;
      }
    });
  });

  if (loading) return <div className="min-h-screen bg-slate-50 flex items-center justify-center text-slate-500">Загрузка...</div>;

  let hoveredOvertime = 0;
  if (hoveredShift && hoveredShift.templateStartTime && hoveredShift.templateEndTime) {
    const sStart = timeToMins(hoveredShift.startTime);
    const sEnd = timeToMins(hoveredShift.endTime);
    const tStart = timeToMins(hoveredShift.templateStartTime);
    const tEnd = timeToMins(hoveredShift.templateEndTime);
    if (sStart < tStart) hoveredOvertime += tStart - sStart;
    if (sEnd > tEnd) hoveredOvertime += sEnd - tEnd;
  }

  const lateness = hoveredShift?.latenessMinutes || 0;
  const early = hoveredShift?.earlyLeaveMinutes || 0;
  const hasViolation = lateness > 0 || early > 0;
  const hoveredIsNoShow = !!(hoveredShift as any)?.isNoShow;
  const hoveredIsUnknown = !!(hoveredShift as any)?.isUnknownAbsence;
  const hoveredIsAbsent = hoveredIsNoShow || hoveredIsUnknown;

  const hoveredStatus: "future" | "active" | "ended" | null = (() => {
    if (!hoveredShift) return null;
    const st = getShiftStatus(hoveredShift);
    return st === "past" ? "ended" : st === "active" ? "active" : "future";
  })();

  let overtimeText = "";
  if (hoveredOvertime > 0) {
    overtimeText = hoveredOvertime >= 60 ? formatHours(hoveredOvertime / 60) : `${hoveredOvertime} мин`;
  }

  const pendingTimeOffs = timeOffs.filter((t) => t.status === "PENDING");
  const pendingSwaps = swapsIncomingList.filter((s) => s.status === "PENDING");
  const pendingVacations = vacations.filter((v) => v.status === "PENDING");
  const totalRequests =
             pendingTimeOffs.length +
             pendingSwaps.length +
             pendingVacations.length +
             pendingShiftChanges.length;

  const handleApproveTimeOff = async (id: string) => {
    await approveTimeOff(id);
    loadAllData();
  };

  const handleApproveSwap = async (id: string) => {
             await acceptSwap(id);
             loadAllData();
           };

           const handleApproveShiftChange = async (id: string) => {
             await shiftChangeRequestsApi.approve(id);
             refreshNotifs();
             loadAllData();
           };

           const handleRejectShiftChange = async (id: string) => {
             await shiftChangeRequestsApi.reject(id);
             refreshNotifs();
             loadAllData();
           };

  // Универсальная навигация: по shiftId ищем weekId
  const findWeekIdByShiftId = (shiftId: string | null | undefined): string | null => {
    if (!shiftId) return data?.currentWeek?.id ?? null;
    const found = data?.currentWeek?.shifts?.find((s: any) => s.id === shiftId);
    return (found as any)?.weekId ?? data?.currentWeek?.id ?? null;
  };

  return (
    <div className="min-h-screen bg-slate-50 flex flex-col">
      <NavBar />

      <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 flex flex-col gap-6">
        {data?.currentWeek ? (
          <button
            onClick={() => navigate("/weeks")}
            className="w-full bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden text-left hover:shadow-md hover:border-brand-300 transition-all flex flex-col group"
          >
            <div className="flex items-center justify-between p-4 border-b border-slate-100 bg-slate-50/50">
              <div className="flex items-center gap-3">
                <CalendarDays className="w-5 h-5 text-brand-600" />
                <h2 className="text-sm font-semibold text-slate-900 uppercase tracking-wide">
                  {MONTHS_RU[new Date(data.currentWeek.weekStartDate + "T00:00:00Z").getUTCMonth()]}{" "}
                  {new Date(data.currentWeek.weekStartDate + "T00:00:00Z").getUTCFullYear()}
                </h2>
                <span className={`text-xs px-2 py-0.5 rounded-full font-medium ring-1 ${STATUS_COLORS[data.currentWeek.status]}`}>
                  {STATUS_LABELS[data.currentWeek.status]}
                </span>
              </div>
              <div className="flex items-center gap-4">
                <div className="text-right">
                  <div className="text-[10px] text-slate-500 uppercase tracking-wide font-medium">Смен за неделю</div>
                  <div className="font-bold text-slate-900">{(data.currentWeek.shifts || []).length}</div>
                </div>
                <div className="w-px h-6 bg-slate-200" />
                <div className="text-right pr-2">
                  <div className="text-[10px] text-slate-500 uppercase tracking-wide font-medium">Затраты</div>
                  <div className="font-bold text-emerald-600">{formatMoney(weekCost)}</div>
                </div>
                <ChevronRight className="w-4 h-4 text-slate-400 group-hover:text-brand-600 transition-colors" />
              </div>
            </div>

            <div className="grid grid-cols-7 w-full divide-x divide-slate-100">
              {dates.map((date, idx) => {
                const isToday = date === todayDate;
                const isSelected = date === selectedDate;
                const allDayShifts = data.currentWeek?.shifts?.filter((s) => String(s.shiftDate).slice(0, 10) === date) || [];
                const dayShifts = isEmployee ? allDayShifts.filter((s) => s.userId === user?.id) : allDayShifts;
                const dayCost = calcCost(dayShifts);

                return (
                  <div
                    key={date}
                    onClick={(e) => {
                      e.stopPropagation();
                      setSelectedDate(date);
                    }}
                    className={`p-2 flex flex-col min-h-[140px] transition-colors cursor-pointer ${
                      isSelected ? "bg-brand-50 ring-2 ring-brand-500/30" : isToday ? "bg-brand-50/30" : "hover:bg-slate-50"
                    }`}
                  >
                    <div className="flex items-center justify-between text-[11px] whitespace-nowrap mb-1">
                      <div className="flex items-center gap-1.5">
                        <span className={`font-bold ${isSelected || isToday ? "text-brand-700" : "text-slate-900"}`}>
                          {parseInt(date.slice(8), 10)}
                        </span>
                        <span className="text-slate-400 font-medium">{WEEKDAYS_RU[idx]}</span>
                      </div>
                    </div>
                    <div className="text-[10px] text-slate-500 mb-2 font-medium">
                      {dayShifts.length} см. • {new Intl.NumberFormat("ru-RU").format(dayCost)} ₽
                    </div>
                    <div className="relative flex-1 bg-slate-50 rounded-sm border border-slate-100 p-1 overflow-hidden">
                      <div className="relative w-full h-full flex flex-col gap-1 items-start pt-1">
                        {dayShifts.map((s, i) => {
                          let startPct = timeToPercent(s.startTime);
                          let endPct = timeToPercent(s.endTime);
                          if (endPct <= startPct) endPct = 100;
                          return (
                            <div key={i} className="relative w-full h-1.5 shrink-0">
                              <div
                                className="absolute inset-y-0 rounded-full bg-blue-500 hover:bg-blue-600 transition-colors"
                                style={{
                                  left: `${startPct}%`,
                                  width: `${Math.max(endPct - startPct, 1)}%`,
                                }}
                                title={`${s.startTime}–${s.endTime}`}
                              />
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </button>
        ) : (
          <div className="bg-white rounded-2xl border border-slate-200 p-6 text-center text-slate-500">
            Текущая неделя не найдена.{" "}
            <button onClick={() => navigate("/weeks")} className="text-brand-600 underline">Перейти в недели</button>.
          </div>
        )}

        <div className={isEmployee ? "flex flex-col gap-4" : "flex flex-col lg:flex-row gap-6 flex-1"}>
          <div className={`bg-white rounded-2xl border border-slate-200 shadow-sm p-5 flex flex-col min-w-0 ${isEmployee ? "shrink-0" : "flex-1"}`}>
            <div className="flex items-center justify-between mb-3 flex-wrap gap-2">
              <div>
                <h2 className="text-xl font-bold text-slate-900 flex items-center gap-2 flex-wrap">
                  {selectedDate === todayDate ? "Сегодня" : dayLabel(selectedDate)},
                  <span className="text-sm font-normal text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md">
                    {shortDate(selectedDate)}
                  </span>

                  <div className="flex items-center gap-1 ml-2">
                    <button
                      onClick={() => canPrev && setSelectedDate(addDays(selectedDate, -1))}
                      disabled={!canPrev}
                      className="p-1.5 rounded-lg hover:bg-slate-100 text-slate-600 disabled:opacity-30 disabled:hover:bg-transparent transition-colors"
                    >
                      <ChevronLeft className="w-4 h-4" />
                    </button>
                    <button
                      onClick={() => canNext && setSelectedDate(addDays(selectedDate, 1))}
                      disabled={!canNext}
                      className="p-1.5 rounded-lg hover:bg-slate-100 text-slate-600 disabled:opacity-30 disabled:hover:bg-transparent transition-colors"
                    >
                      <ChevronRight className="w-4 h-4" />
                    </button>
                    <input
                      type="date"
                      value={selectedDate}
                      min={dates[0]}
                      max={dates[6]}
                      onChange={(e) => setSelectedDate(e.target.value)}
                      onClick={(e) => e.stopPropagation()}
                      className="!w-36 !text-xs !py-1"
                    />
                    <button
                      onClick={() => setSelectedDate(todayDate)}
                      disabled={!dateInWeek || selectedDate === todayDate}
                      className="text-[10px] px-2 py-1 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 disabled:opacity-30 whitespace-nowrap"
                    >
                      Сегодня
                    </button>
                  </div>
                </h2>
              </div>

              <div className="flex items-center gap-3">
                <div className="text-right">
                  <div className="text-[10px] text-slate-500 uppercase tracking-wide font-medium">Смен</div>
                  <div className="font-bold text-slate-900 text-sm">{todayShiftsToShow.length}</div>
                </div>
                <div className="w-px h-6 bg-slate-200" />
                <div className="text-right">
                  <div className="text-[10px] text-slate-500 uppercase tracking-wide font-medium">Затраты</div>
                  <div className="font-bold text-emerald-600 text-sm">{formatMoney(todayCost)}</div>
                </div>
              </div>
            </div>

            <div className="h-10 mb-2 flex items-center justify-center transition-all">
              {hoveredShift && hoveredStatus && (
                <div
                  className={`animate-fade-in flex items-center gap-2 px-5 py-2 rounded-full border shadow-sm ${
                    hoveredIsAbsent
                      ? "bg-rose-50 border-rose-200"
                      : hoveredStatus === "future"
                      ? "bg-slate-50 border-slate-200"
                      : hasViolation
                      ? "bg-rose-50 border-rose-200"
                      : "bg-emerald-50 border-emerald-200"
                  }`}
                >
                  <span className="text-sm font-bold tracking-wide flex items-center gap-2 flex-wrap">
                    {hoveredIsAbsent ? (
                      <span className="text-rose-700">
                        {hoveredIsNoShow ? "Прогул (ПР)" : "Отсутствие по неизвестной причине (НН)"}
                      </span>
                    ) : hoveredStatus === "future" ? (
                      <span className="text-slate-600">Не началась</span>
                    ) : (
                      <>
                        {lateness > 0 && <span className="text-rose-700">Опоздание: {lateness} мин</span>}
                        {lateness > 0 && (early > 0 || hoveredOvertime > 0) && <span className="text-rose-300">|</span>}
                        {early > 0 && <span className="text-rose-700">Ранний уход: {early} мин</span>}
                        {early > 0 && hoveredOvertime > 0 && <span className="text-rose-300">|</span>}
                        {hoveredOvertime > 0 && <span className="text-emerald-600">Переработка: {overtimeText}</span>}
                        {lateness === 0 && early === 0 && hoveredOvertime === 0 && (
                          <span className="text-emerald-700">
                            {hoveredStatus === "ended" ? "Смена окончена" : "Приход вовремя"}
                          </span>
                        )}
                      </>
                    )}
                  </span>
                </div>
              )}
            </div>

            <div className={`relative overflow-x-auto overflow-y-hidden ${isEmployee ? "min-h-[220px]" : "flex-1 min-h-[400px]"}`}>
              <div className="min-w-[800px] h-full flex flex-col relative">
                <div className="absolute inset-0 pointer-events-none z-0">
                  {Array.from({ length: 25 }).map((_, i) => (
                    <div key={i} className="absolute top-0 bottom-0 border-l border-slate-100" style={{ left: `${(i / 24) * 100}%` }} />
                  ))}
                  {selectedDate === todayDate && (
                    <>
                      <div className="absolute top-0 bottom-0 bg-slate-900/5 left-0" style={{ width: `${currentTimePercent}%` }} />
                      <div className="absolute top-0 bottom-0 bg-red-500 w-0.5 z-20" style={{ left: `${currentTimePercent}%` }} />
                    </>
                  )}
                </div>

                <div className={`relative shrink-0 z-10 w-full mb-1 ${isEmployee ? "h-8" : "h-14"}`}>
                  {[0, 3, 6, 9, 12, 15, 18, 21, 24].map((h) => {
                    let alignClass = "-translate-x-1/2";
                    if (h === 0) alignClass = "translate-x-0";
                    if (h === 24) alignClass = "-translate-x-full";
                    return (
                      <div key={`h-${h}`} className={`absolute text-[11px] font-semibold text-slate-500 ${alignClass}`} style={{ left: `${(h / 24) * 100}%`, top: 0 }}>
                        {h}:00
                      </div>
                    );
                  })}
                </div>

                <div className="flex-1 relative z-10">
                  {todayShiftsToShow.length === 0 ? (
                    <div className={`flex flex-col items-center justify-center h-full text-slate-400 relative z-20 ${isEmployee ? "py-6" : "py-12"}`}>
                      <CalendarX2 className={`mb-3 text-slate-300 ${isEmployee ? "w-8 h-8" : "w-12 h-12"}`} />
                      <p>{isEmployee ? "У вас нет смен в этот день" : "На этот день смен нет"}</p>
                    </div>
                  ) : (
                    todayShiftsToShow.map((shift) => {
                      let startPct = timeToPercent(shift.startTime);
                      let endPct = timeToPercent(shift.endTime);
                      if (endPct <= startPct) endPct = 100;
                      const widthPct = Math.max(endPct - startPct, 1);

                      const st = getShiftStatus(shift);
                      const isEnded = st === "past";
                      const isStarted = st === "active";
                      const isAbsent = shift.isNoShow || shift.isUnknownAbsence;

                      const sLateness = shift.latenessMinutes || 0;
                      const sEarly = shift.earlyLeaveMinutes || 0;
                      const shiftDurationMinutes = calcHours(shift.startTime, shift.endTime) * 60;
                      const latenessPct = shiftDurationMinutes > 0 ? (sLateness / shiftDurationMinutes) * 100 : 0;
                      const earlyLeavePct = shiftDurationMinutes > 0 ? (sEarly / shiftDurationMinutes) * 100 : 0;

                      let overtimeStartPct = 0;
                      let overtimeEndPct = 0;
                      if (shift.templateStartTime && shift.templateEndTime) {
                        const sStart = timeToMins(shift.startTime);
                        const sEnd = timeToMins(shift.endTime);
                        const tStart = timeToMins(shift.templateStartTime);
                        const tEnd = timeToMins(shift.templateEndTime);
                        if (sStart < tStart) overtimeStartPct = ((tStart - sStart) / (24 * 60)) * 100;
                        if (sEnd > tEnd) overtimeEndPct = ((sEnd - tEnd) / (24 * 60)) * 100;
                      }

                      const barColor = shift.pendingTimeOff
                        ? "#f59e0b"
                        : isAbsent
                        ? "#dc2626"
                        : isEnded
                        ? "#cbd5e1"
                        : shift.templateColor || "#3b82f6";

                      return (
                        <div
                          key={shift.id}
                          onMouseEnter={() => setHoveredShift(shift)}
                          onMouseLeave={() => setHoveredShift(null)}
                          onClick={(e) => {
                            e.stopPropagation();
                            if (!isEmployee && selectedDate <= todayDate) {
                              setDisciplineShift(shift);
                            }
                          }}
                          className={`flex items-center relative transition-colors ${
                            isEmployee
                              ? "h-12"
                              : `h-14 ${selectedDate <= todayDate ? "cursor-pointer hover:bg-slate-50/80 hover:ring-2 hover:ring-amber-400 hover:z-30" : ""}`
                          }`}
                        >
                          <div className="w-40 shrink-0 pr-2 flex items-center gap-2 relative z-30 pointer-events-none">
                            <div className="relative w-7 h-7 flex items-center justify-center shrink-0">
                              <div className="w-7 h-7 rounded-full bg-slate-200 flex items-center justify-center">
                                <UserCircle className="w-4 h-4 text-slate-500" />
                              </div>
                              <span className={`absolute -top-0.5 -right-1.5 w-2.5 h-2.5 rounded-full border-2 border-white shadow-sm ${
                                isAbsent || sLateness > 0 || sEarly > 0 ? "bg-rose-500" : "bg-emerald-500"
                              }`} />
                            </div>
                            <div className="min-w-0 bg-white/80 backdrop-blur-sm px-1.5 py-0.5 rounded">
                              <div className="text-xs font-semibold text-slate-900 truncate">{shift.userName}</div>
                              <div className="text-[10px] text-slate-500 truncate">{shift.userPosition || "Сотрудник"}</div>
                            </div>
                          </div>

                          <div
                            className={`absolute rounded-md shadow-sm overflow-hidden z-10 flex items-center ${isEmployee ? "h-7 top-2.5" : "h-8 top-3"}`}
                            style={{
                              left: `${startPct}%`,
                              width: `${widthPct}%`,
                              backgroundColor: barColor,
                            }}
                          >
                            {!isAbsent && !shift.pendingTimeOff && sLateness > 0 && (
                              <div className="absolute left-0 top-0 bottom-0 bg-rose-600/90 border-r-2 border-rose-800 z-10" style={{ width: `${latenessPct}%` }} />
                            )}
                            {!isAbsent && !shift.pendingTimeOff && overtimeStartPct > 0 && (
                              <div className="absolute left-0 top-0 bottom-0 bg-emerald-500/90 border-r-2 border-emerald-700 z-10" style={{ width: `${overtimeStartPct}%` }} />
                            )}
                            {!isAbsent && !shift.pendingTimeOff && sEarly > 0 && (
                              <div className="absolute right-0 top-0 bottom-0 bg-rose-600/90 border-l-2 border-rose-800 z-10" style={{ width: `${earlyLeavePct}%` }} />
                            )}
                            {!isAbsent && !shift.pendingTimeOff && overtimeEndPct > 0 && (
                              <div className="absolute right-0 top-0 bottom-0 bg-emerald-500/90 border-l-2 border-emerald-700 z-10" style={{ width: `${overtimeEndPct}%` }} />
                            )}

                            <span className="absolute left-2 top-1/2 -translate-y-1/2 text-[10px] text-white truncate drop-shadow-md z-20 flex items-center gap-1.5">
                              {isAbsent && <span className="font-bold">{shift.isNoShow ? "ПР" : "НН"}</span>}
                              <span className={isAbsent ? "opacity-80 font-normal" : "font-medium"}>
                                {shift.startTime} – {shift.endTime}
                              </span>
                              {shift.templateName && !shift.pendingTimeOff && (
                                <span className="opacity-80 font-normal">· {shift.templateName}</span>
                              )}
                              {shift.pendingTimeOff && (
                                <span className="font-bold bg-amber-900/20 px-1 rounded ml-1">Отгул</span>
                              )}
                            </span>

                            <div className="absolute right-1 top-1/2 -translate-y-1/2 flex gap-1 z-30">
                              {shift.pendingSwap && (
                                <span className="bg-blue-400 text-blue-950 rounded-full p-0.5 shadow-sm" title="Запрос на обмен">
                                  <ArrowRightLeft className="w-3 h-3" />
                                </span>
                              )}
                            </div>
                          </div>

                          <div className="w-28 shrink-0 pl-2 text-right relative z-30 ml-auto pointer-events-none">
                            <div className="bg-white/80 backdrop-blur-sm px-2 py-0.5 rounded inline-block">
                              {shift.pendingTimeOff ? (
                                <span className="text-[10px] font-medium text-amber-600">Ждет отгул</span>
                              ) : isAbsent ? (
                                <span className="text-[10px] font-medium text-rose-600">
                                  {shift.isNoShow ? "Прогул" : "Неявка"}
                                </span>
                              ) : isEnded ? (
                                <span className="text-[10px] font-medium text-slate-400">Окончена</span>
                              ) : isStarted ? (
                                <span className="text-[10px] font-medium text-emerald-600 flex items-center justify-end gap-1">
                                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                                  В работе
                                </span>
                              ) : (
                                <span className="text-[10px] font-medium text-brand-600">Не началась</span>
                              )}
                            </div>
                          </div>
                        </div>
                      );
                    })
                  )}
                </div>
              </div>
            </div>
          </div>

          {isEmployee ? (
            <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
              <StatCard icon={Clock} label="Смена (день)" value={formatHours(plannedToday)} />
              <StatCard icon={Timer} label="Отработано (день)" value={formatHours(actualToday)} highlight />
              <StatCard icon={CalendarDays} label="Часов на неделе" value={formatHours(plannedWeek)} />
              <StatCard icon={Activity} label="Отработано за неделю" value={formatHours(actualWeek)} highlight />
              <StatCard icon={Banknote} label="Заработает за неделю" value={formatMoney(plannedWeek * hourlyRate)} />
              <StatCard icon={Wallet} label="Заработано" value={formatMoney(actualWeek * hourlyRate)} highlight />
              <div className="col-span-2">
                <StatCard
                  icon={UserCircle}
                  label="Текущий статус"
                  value={statusText}
                  alert={statusText === "Не началась" || statusText === "Неявка" || statusText === "Прогул"}
                  highlight={isWorking}
                />
              </div>
            </div>
          ) : (
            <div className="w-full lg:w-80 shrink-0 grid grid-cols-2 gap-3 auto-rows-max">
              <StatCard
                icon={Timer}
                label="В работе"
                value={todayShiftsToShow.filter((s) => getShiftStatus(s) === "active" && !(s.isNoShow || s.isUnknownAbsence)).length || 0}
                highlight
              />
              <StatCard icon={ArrowRightLeft} label="Обмены" value={pendingSwaps.length} onClick={() => navigate("/swaps")} />
              <StatCard
                icon={AlertCircle}
                label="Запросы"
                value={totalRequests}
                onClick={() => setShowRequestsModal(true)}
                alert={totalRequests > 0}
              />
              <StatCard icon={FileEdit} label="Ред. смены" value={data ? data.currentWeek?.shifts?.filter((s: any) => s.status === "REQUESTED").length || 0 : 0} onClick={() => navigate("/weeks")} />
              <div className="col-span-2 grid grid-cols-2 gap-3">
                <StatCard icon={CalendarDays} label="Смен за месяц" value={monthShiftsCount} />
                <StatCard icon={Wallet} label="Затраты за месяц" value={formatMoney(monthCost)} />
              </div>
            </div>
          )}
        </div>
      </main>

      {disciplineShift && (
        <DisciplineModal
          shift={disciplineShift}
          onClose={() => setDisciplineShift(null)}
          onSave={async () => {
            if (!activeLocationId) return;
            const res = await dashboardApi.summary(activeLocationId);
            setData(res);
          }}
        />
      )}

      {showRequestsModal && (
        <div className="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4" onClick={() => setShowRequestsModal(false)}>
          <div className="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-xl w-full p-6 max-h-[85vh] flex flex-col animate-fade-in" onClick={(e) => e.stopPropagation()}>
            <div className="flex items-center justify-between mb-4">
              <h3 className="font-semibold text-slate-900 text-lg flex items-center gap-2">
                <Bell className="w-5 h-5 text-brand-600" />
                Все запросы ({totalRequests})
              </h3>
              <button onClick={() => setShowRequestsModal(false)} className="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-100">
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="flex-1 overflow-y-auto space-y-4 pr-1">
              {totalRequests === 0 && (
                <p className="text-center text-sm text-slate-500 py-6">Нет активных запросов</p>
              )}

              {pendingVacations.map((v) => (
                <div key={v.id} className="bg-emerald-50 border border-emerald-200 p-3 rounded-xl flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <div className="text-sm font-medium text-slate-900 flex items-center gap-1.5">
                      <Palmtree className="w-4 h-4 text-emerald-600" /> {v.userName}
                    </div>
                    <div className="text-xs text-slate-500 mt-0.5">{v.startDate} — {v.endDate}</div>
                  </div>
                  <button onClick={() => { setShowRequestsModal(false); navigate("/vacations"); }} className="text-xs bg-white border border-emerald-300 text-emerald-700 px-3 py-1.5 rounded-lg hover:bg-emerald-100 font-medium">
                    Перейти
                  </button>
                </div>
              ))}

              {pendingTimeOffs.map((t) => {
                const targetWeekId = findWeekIdByShiftId(t.shiftId);
                return (
                  <div key={t.id} className="bg-amber-50 border border-amber-200 p-3 rounded-xl">
                    <div className="flex items-center justify-between gap-3 mb-2 flex-wrap">
                      <div>
                        <div className="text-sm font-medium text-slate-900 flex items-center gap-1.5">
                          <CalendarX2 className="w-4 h-4 text-amber-600" /> {t.userName}
                        </div>
                        <div className="text-xs text-slate-500 mt-0.5">Отгул на {t.date}</div>
                      </div>
                      <div className="flex gap-1.5">
                        <button onClick={() => handleApproveTimeOff(t.id)} className="text-xs bg-emerald-600 text-white px-2.5 py-1.5 rounded-lg hover:bg-emerald-700 font-medium">Одобрить</button>
                        <button onClick={async () => { await rejectTimeOff(t.id); fetchTimeOffs(); }} className="text-xs text-rose-600 hover:bg-rose-100 px-2.5 py-1.5 rounded-lg font-medium">Отклонить</button>
                      </div>
                    </div>
                    <button
                      onClick={() => {
                        setShowRequestsModal(false);
                        if (targetWeekId) navigate(`/weeks/${targetWeekId}`);
                        else navigate("/weeks");
                      }}
                      className="text-xs text-amber-800 hover:underline flex items-center gap-1"
                    >
                      Посмотреть в расписании <ChevronRight className="w-3 h-3" />
                    </button>
                  </div>
                );
              })}

              {pendingSwaps.map((s) => {
                const targetWeekId = findWeekIdByShiftId(s.shiftId);
                return (
                  <div key={s.id} className="bg-blue-50 border border-blue-200 p-3 rounded-xl">
                    <div className="flex items-center justify-between gap-3 mb-2 flex-wrap">
                      <div>
                        <div className="text-sm font-medium text-slate-900 flex items-center gap-1.5">
                          <ArrowRightLeft className="w-4 h-4 text-blue-600" /> {s.requestedByName}
                        </div>
                        <div className="text-xs text-slate-500 mt-0.5">{s.shiftDate} · {s.startTime}–{s.endTime}</div>
                      </div>
                      <div className="flex gap-1.5">
                        <button onClick={() => handleApproveSwap(s.id)} className="text-xs bg-emerald-600 text-white px-2.5 py-1.5 rounded-lg hover:bg-emerald-700 font-medium">Принять</button>
                        <button onClick={async () => { await declineSwap(s.id); fetchSwaps(); }} className="text-xs text-rose-600 hover:bg-rose-100 px-2.5 py-1.5 rounded-lg font-medium">Отклонить</button>
                      </div>
                    </div>
                    <button
                      onClick={() => {
                        setShowRequestsModal(false);
                        if (targetWeekId) navigate(`/weeks/${targetWeekId}`);
                        else navigate("/weeks");
                      }}
                      className="text-xs text-blue-800 hover:underline flex items-center gap-1"
                    >
                      Посмотреть в расписании <ChevronRight className="w-3 h-3" />
                    </button>
                  </div>
                );
              })}
              {pendingShiftChanges.map((r) => {
                         const targetWeekId = r.weekId ?? data?.currentWeek?.id ?? null;
                         return (
                           <div key={r.id} className="bg-amber-50 border border-amber-200 p-3 rounded-xl">
                             <div className="flex items-center justify-between gap-3 mb-2 flex-wrap">
                               <div className="min-w-0">
                                 <div className="text-sm font-medium text-slate-900 flex items-center gap-1.5">
                                   <CalendarDays className="w-4 h-4 text-amber-600" />
                                   {r.requestedByName ?? "Сотрудник"}
                                 </div>
                                 <div className="text-xs text-slate-500 mt-0.5">
                                   {r.kind === "CREATE" ? "Новая смена" : "Изменение смены"}
                                 </div>
                               </div>
                               <div className="flex gap-1.5">
                                 <button
                                   onClick={() => handleApproveShiftChange(r.id)}
                                   className="text-xs bg-emerald-600 text-white px-2.5 py-1.5 rounded-lg hover:bg-emerald-700 font-medium"
                                 >
                                   Принять
                                 </button>
                                 <button
                                   onClick={() => handleRejectShiftChange(r.id)}
                                   className="text-xs text-rose-600 hover:bg-rose-100 px-2.5 py-1.5 rounded-lg font-medium"
                                 >
                                   Отклонить
                                 </button>
                               </div>
                             </div>
                             <div className="text-xs space-y-0.5 mb-2">
                               {r.kind === "UPDATE" ? (
                                 <>
                                   <div className="text-slate-400 line-through">
                                     {r.oldShiftDate.slice(0, 10)} · {r.oldStartTime}–{r.oldEndTime}
                                   </div>
                                   <div className="text-slate-900 font-medium">
                                     {r.newShiftDate.slice(0, 10)} · {r.newStartTime}–{r.newEndTime}
                                   </div>
                                 </>
                               ) : (
                                 <div className="text-slate-900 font-medium">
                                   {r.newShiftDate.slice(0, 10)} · {r.newStartTime}–{r.newEndTime}
                                 </div>
                               )}
                             </div>
                             <button
                               onClick={() => {
                                 setShowRequestsModal(false);
                                 if (targetWeekId) navigate(`/weeks/${targetWeekId}`);
                                 else navigate("/weeks");
                               }}
                               className="text-xs text-amber-800 hover:underline flex items-center gap-1"
                             >
                               Посмотреть в расписании <ChevronRight className="w-3 h-3" />
                             </button>
                           </div>
                         );
                       })}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function DisciplineModal({ shift, onClose, onSave }: any) {
  const [lateness, setLateness] = useState(shift.latenessMinutes || 0);
  const [earlyLeave, setEarlyLeave] = useState(shift.earlyLeaveMinutes || 0);
  const [isNoShow, setIsNoShow] = useState(shift.isNoShow || false);
  const [isUnknownAbsence, setIsUnknownAbsence] = useState(shift.isUnknownAbsence || false);
  const [busy, setBusy] = useState(false);

  let overtimeMins = 0;
  if (shift.templateStartTime && shift.templateEndTime) {
    const sStart = timeToMins(shift.startTime);
    const sEnd = timeToMins(shift.endTime);
    const tStart = timeToMins(shift.templateStartTime);
    const tEnd = timeToMins(shift.templateEndTime);
    if (sStart < tStart) overtimeMins += tStart - sStart;
    if (sEnd > tEnd) overtimeMins += sEnd - tEnd;
  }

  const isAbsent = isNoShow || isUnknownAbsence;

  const handleSave = async () => {
    setBusy(true);
    try {
      await shiftsApi.update(shift.id, {
        latenessMinutes: isAbsent ? 0 : lateness,
        earlyLeaveMinutes: isAbsent ? 0 : earlyLeave,
        isNoShow,
        isUnknownAbsence,
      } as any);
      await onSave();
      onClose();
    } catch (e: any) {
      alert(e.response?.data?.error ?? "Ошибка сохранения");
    } finally {
      setBusy(false);
    }
  };

  return (
    <div
      className="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-fade-in"
      onClick={onClose}
    >
      <div
        className="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-md w-full p-6"
        onClick={(e) => e.stopPropagation()}
      >
        <div className="flex items-start justify-between mb-5">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
              <AlertTriangle className="w-5 h-5 text-amber-600" />
            </div>
            <div>
              <h3 className="font-semibold text-slate-900 text-lg">Дисциплина</h3>
              <p className="text-xs text-slate-500">
                {shift.userName} · {shift.startTime}–{shift.endTime}
                {shift.templateName && ` · ${shift.templateName}`}
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-100"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        <label className={`flex items-start gap-3 p-3 rounded-xl border-2 mb-3 cursor-pointer transition-all ${
          isNoShow ? "bg-rose-50 border-rose-300" : "bg-slate-50 border-slate-200 hover:border-slate-300"
        }`}>
          <input
            type="checkbox"
            checked={isNoShow}
            onChange={(e) => {
              setIsNoShow(e.target.checked);
              if (e.target.checked) setIsUnknownAbsence(false);
            }}
            className="!w-4 !h-4 mt-1 !p-0 cursor-pointer accent-rose-600"
          />
          <div>
            <div className={`text-sm font-semibold ${isNoShow ? "text-rose-900" : "text-slate-900"}`}>
              Прогул (ПР)
            </div>
            <div className="text-xs text-slate-500 mt-0.5">
              Сотрудник не пришёл без уважительной причины.
            </div>
          </div>
        </label>

        <label className={`flex items-start gap-3 p-3 rounded-xl border-2 mb-4 cursor-pointer transition-all ${
          isUnknownAbsence ? "bg-rose-50 border-rose-300" : "bg-slate-50 border-slate-200 hover:border-slate-300"
        }`}>
          <input
            type="checkbox"
            checked={isUnknownAbsence}
            onChange={(e) => {
              setIsUnknownAbsence(e.target.checked);
              if (e.target.checked) setIsNoShow(false);
            }}
            className="!w-4 !h-4 mt-1 !p-0 cursor-pointer accent-rose-600"
          />
          <div>
            <div className={`text-sm font-semibold ${isUnknownAbsence ? "text-rose-900" : "text-slate-900"}`}>
              Отсутствие по неизвестной причине (НН)
            </div>
            <div className="text-xs text-slate-500 mt-0.5">
              Причина отсутствия пока не установлена.
            </div>
          </div>
        </label>

        <div className={`space-y-5 ${isAbsent ? "opacity-40 pointer-events-none" : ""}`}>
          <div>
            <label className="block text-sm font-medium text-slate-700 mb-2">Опоздание (мин)</label>
            <div className="flex gap-2 flex-wrap">
              {[0, 5, 15, 30, 60].map((m) => (
                <button
                  key={m}
                  onClick={() => setLateness(m)}
                  className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
                    lateness === m ? "bg-rose-600 text-white shadow-sm" : "bg-slate-100 text-slate-700 hover:bg-slate-200"
                  }`}
                >
                  {m === 0 ? "Нет" : `До ${m}`}
                </button>
              ))}
            </div>
          </div>

          <div>
            <label className="block text-sm font-medium text-slate-700 mb-2">Ранний уход (мин)</label>
            {overtimeMins > 0 ? (
              <p className="text-xs text-rose-500 mb-2 font-medium">
                Нельзя указать ранний уход при наличии переработки.
              </p>
            ) : (
              <p className="text-xs text-slate-400 mb-2">Доступно только если нет переработки.</p>
            )}
            <div className="flex gap-2 flex-wrap">
              {[0, 5, 15, 30, 60].map((m) => (
                <button
                  key={m}
                  onClick={() => setEarlyLeave(m)}
                  disabled={overtimeMins > 0 && m > 0}
                  className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
                    earlyLeave === m ? "bg-rose-600 text-white shadow-sm" : "bg-slate-100 text-slate-700 hover:bg-slate-200"
                  } ${overtimeMins > 0 && m > 0 ? "opacity-50 cursor-not-allowed" : ""}`}
                >
                  {m === 0 ? "Нет" : `До ${m}`}
                </button>
              ))}
            </div>
          </div>
        </div>

        <div className="flex gap-2 mt-8">
          <button
            onClick={handleSave}
            disabled={busy}
            className="flex-1 bg-brand-600 text-white px-4 py-2.5 rounded-xl hover:bg-brand-700 disabled:opacity-50 text-sm font-medium transition-all shadow-sm"
          >
            {busy ? "Сохранение..." : "Сохранить"}
          </button>
          <button
            onClick={onClose}
            className="px-4 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 text-sm font-medium transition-colors"
          >
            Отмена
          </button>
        </div>
      </div>
    </div>
  );
}

function StatCard({ icon: Icon, label, value, onClick, highlight, alert }: any) {
  return (
    <button
      onClick={onClick}
      className={`flex flex-col items-start p-4 rounded-2xl border text-left transition-all ${
        onClick ? "hover:shadow-md hover:border-slate-300" : ""
      } ${
        highlight ? "bg-emerald-50 border-emerald-200"
        : alert ? "bg-amber-50 border-amber-200"
        : "bg-white border-slate-200"
      }`}
    >
      <div className={`w-8 h-8 rounded-lg flex items-center justify-center mb-3 ${
        highlight ? "bg-emerald-100 text-emerald-600"
        : alert ? "bg-amber-100 text-amber-600"
        : "bg-slate-100 text-slate-600"
      }`}>
        <Icon className="w-4 h-4" />
      </div>
      <div className="text-xs text-slate-500 font-medium mb-1">{label}</div>
      <div className="text-lg font-bold text-slate-900 leading-tight">{value}</div>
    </button>
  );
}