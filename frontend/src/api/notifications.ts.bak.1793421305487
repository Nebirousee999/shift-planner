import { api } from "./client";

export const notificationsApi = {
  vacationsPendingCount: async (): Promise<number> => {
    try {
      const { data } = await api.get<{ count: number }>(
        "/vacations/pending/count"
      );
      return data.count;
    } catch {
      return 0;
    }
  },

  swapsIncomingCount: async (): Promise<number> => {
    try {
      const { data } = await api.get<{ count: number }>(
        "/swaps/incoming/count"
      );
      return data.count;
    } catch {
      return 0;
    }
  },

  // ← НОВОЕ
  shiftChangesIncomingCount: async (): Promise<number> => {
    try {
      const { data } = await api.get<{ count: number }>(
        "/shift-change-requests/incoming/count"
      );
      return data.count;
    } catch {
      return 0;
    }
  },

  timeOffsPendingCount: async (): Promise<number> => {
    try {
      const { data } = await api.get<{ count: number }>("/time-off/pending/count");
      return data.count;
    } catch { return 0; }
  },

};