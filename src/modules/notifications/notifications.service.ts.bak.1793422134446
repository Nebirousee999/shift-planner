import { eq, and, isNull, desc, or } from "drizzle-orm";
import { db } from "../../../db/client.js";
import { userNotifications, users } from "../../../db/schema.js";

export type CreateNotificationInput = {
  orgId: string;
  userId: string;
  kind: string;
  title: string;
  message: string;
  relatedId?: string | null;
  relatedType?: string | null;
  requiresAction?: boolean;
  payload?: any;
};

export const notificationsService = {
  async list(userId: string) {
    return db
      .select()
      .from(userNotifications)
      .where(eq(userNotifications.userId, userId))
      .orderBy(desc(userNotifications.createdAt));
  },

  async unreadCount(userId: string) {
    const rows = await db
      .select({ id: userNotifications.id })
      .from(userNotifications)
      .where(
        and(
          eq(userNotifications.userId, userId),
          isNull(userNotifications.acknowledgedAt)
        )
      );
    return { count: rows.length };
  },

  async create(input: CreateNotificationInput) {
    const [created] = await db
      .insert(userNotifications)
      .values({
        orgId: input.orgId,
        userId: input.userId,
        kind: input.kind,
        title: input.title,
        message: input.message,
        relatedId: input.relatedId ?? null,
        relatedType: input.relatedType ?? null,
        requiresAction: input.requiresAction ?? false,
        payload: input.payload ?? null,
      })
      .returning();
    return created;
  },

  async notifyManagers(
    input: Omit<CreateNotificationInput, "userId"> & { excludeUserId?: string }
  ) {
    const managers = await db
      .select({ id: users.id })
      .from(users)
      .where(
        and(
          eq(users.orgId, input.orgId),
          or(eq(users.role, "OWNER"), eq(users.role, "MANAGER"))
        )
      );

    for (const m of managers) {
      if (input.excludeUserId && m.id === input.excludeUserId) continue;
      await this.create({ ...input, userId: m.id });
    }
  },

  async acknowledge(id: string, userId: string) {
    const [updated] = await db
      .update(userNotifications)
      .set({ acknowledgedAt: new Date() })
      .where(
        and(
          eq(userNotifications.id, id),
          eq(userNotifications.userId, userId)
        )
      )
      .returning();
    return updated;
  },

  async acknowledgeAll(userId: string) {
               await db
                 .update(userNotifications)
                 .set({ acknowledgedAt: new Date() })
                 .where(
                   and(
                     eq(userNotifications.userId, userId),
                     isNull(userNotifications.acknowledgedAt),
                     eq(userNotifications.requiresAction, false)
                   )
                 );
               return { success: true };
             },

             async dismissActionable(relatedId: string, relatedType?: string) {
               const cond = relatedType
                 ? and(
                     eq(userNotifications.relatedId, relatedId),
                     eq(userNotifications.relatedType, relatedType),
                     eq(userNotifications.requiresAction, true),
                     isNull(userNotifications.acknowledgedAt)
                   )
                 : and(
                     eq(userNotifications.relatedId, relatedId),
                     eq(userNotifications.requiresAction, true),
                     isNull(userNotifications.acknowledgedAt)
                   );
               await db.delete(userNotifications).where(cond);
               return { success: true };
             },
};
